# 복사해서 .env 로 저장하고 값을 채우세요. .env 는 GitHub에 올리지 마세요.
# 공공데이터포털 > 마이페이지 > 일반 인증키 (Decoding 값)
DATA_GO_KR_KEY=
# 생성형 AI (Anthropic) API 키. 비우면 규칙 기반으로 동작
ANTHROPIC_API_KEY=
# 키를 만들 때 워크스페이스를 고르지 않았다면 워크스페이스 ID를 넣는다 (골랐다면 비워 둠)
ANTHROPIC_WORKSPACE_ID=
# 가장 싼 모델(Haiku 5.5, 입력 $0.10·출력 $0.50 / 100만 토큰). 대화를 더 자연스럽게: TALK_MODEL=claude-sonnet-5-5
LLM_MODEL=claude-haiku-5-5
LLM_TIMEOUT=6
# 선택: OpenRouteService 무료 키 (이동 시간표를 실제 도로 기준으로)
ORS_API_KEY=
# 웹 화면 주소 (배포 시 추가)
CORS_ORIGINS=http://localhost:3000

# 대화형 동이용 모델·시간 제한 (비우면 LLM_MODEL 사용)
TALK_MODEL=
TALK_TIMEOUT=20

# 관리자 페이지(#/admin) 대표 계정. 비밀번호를 비우면 관리자 페이지가 잠겨요.
ADMIN_ID=admin
ADMIN_PASSWORD=
# 1 이면 로그인 화면에 [임시 로그인] 버튼이 생기고, 누르면 위 계정이 자동 입력돼요 (본선 시연용).
# 누구나 관리자로 들어올 수 있게 되므로 대회가 끝나면 0 으로 바꾸세요.
DEMO_LOGIN=0
# 배포할 때: 서버를 다시 켜도 남는 디스크 경로 (예: Render 디스크 /var/data)
CMS_FILE=
REPORTS_DIR=
# 사이트 잠금: 값이 있으면 접속할 때 이 비밀번호를 물어봐요 (공개 전용). 공개할 때는 지우세요.
SITE_PASSWORD=
